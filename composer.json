{
    "name": "shoplygg/shoply-php",
    "description": "Shoply's API from your own server: every route as a method, safe retries, pages, and checking webhooks.",
    "type": "library",
    "keywords": ["shoply", "api", "sdk", "ecommerce", "webhooks", "digital-goods"],
    "homepage": "https://docs.shoply.gg/api-reference/php",
    "license": "MIT",
    "support": {
        "docs": "https://docs.shoply.gg/api-reference/php",
        "issues": "https://github.com/shoplygg/shoply-php/issues",
        "source": "https://github.com/shoplygg/shoply-php"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "Shoply\\": "src/"
        }
    },
    "scripts": {
        "test": "php tests/client.php"
    }
}
